# Put the project-local Lua 5.2 toolchain built by `make deps` first on PATH, so
# `lua`, `luarocks`, `busted`, `luacheck`, and ./bin/factestio all resolve the
# pinned version instead of whatever the system happens to provide.
#
# direnv evaluates this in bash, never in your interactive shell, so it stays
# portable across zsh/bash/fish. Run `direnv allow` once to enable it.

watch_file .hererocks/bin/lua

if [ -d .hererocks/bin ]; then
  PATH_add .hererocks/bin
else
  log_error "no .hererocks/ toolchain yet -- run 'make deps'"
fi
